/* Story Map — Layout non bloquant
   La carte reste le sujet : aucun overlay plein ecran, aucun bandeau large.
   L'interface tient dans un rail lateral retractable + un caption flotant. */

.story-overlay {
  position: fixed;
  /* Le mode story s'arrête au-dessus du bandeau de crédit : celui-ci doit
     rester lisible pendant une présentation, c'est justement là qu'il compte
     le plus. `--credit-bar-h` est déclarée dans style.css (chargé avant). */
  top: 0; left: 0; right: 0; bottom: var(--credit-bar-h);
  z-index: 20;
  display: none;
  pointer-events: none;
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

.story-overlay * { pointer-events: auto; }
.story-overlay .story-caption,
.story-overlay .story-minimap { pointer-events: none; }
.story-overlay .story-caption * { pointer-events: auto; }

/* ------------------------------------------------------------------ Rail */

.story-rail {
  position: absolute;
  top: 12px;
  left: 12px;
  bottom: 12px;
  width: 320px;
  background: rgba(13, 18, 32, 0.9);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  transition: width 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 22;
}

.story-rail.collapsed { width: 46px; }
.story-rail.collapsed > *:not(.story-rail-top) { display: none; }
.story-rail.collapsed .story-rail-top { flex-direction: column; gap: 10px; }
.story-rail.collapsed .story-brand { display: none; }

.story-rail-top {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px 10px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  flex-shrink: 0;
}

.story-brand {
  flex: 1;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.3px;
  background: linear-gradient(135deg, #4CAF50, #2196F3);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  white-space: nowrap;
  overflow: hidden;
}

.story-rail-toggle,
.story-rail-close {
  background: transparent;
  border: none;
  color: #8899aa;
  cursor: pointer;
  font-size: 15px;
  line-height: 1;
  padding: 4px 6px;
  border-radius: 5px;
  flex-shrink: 0;
}

.story-rail-toggle:hover,
.story-rail-close:hover { background: rgba(255, 255, 255, 0.08); color: #e0e6f0; }

.story-map-select {
  display: flex;
  gap: 6px;
  padding: 10px 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  flex-shrink: 0;
}

.story-map-btn {
  flex: 1;
  padding: 6px 8px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #8899aa;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.18s;
}

.story-map-btn:hover { background: rgba(255, 255, 255, 0.1); color: #e0e6f0; }
.story-map-btn.active { background: rgba(76, 175, 80, 0.18); border-color: rgba(76, 175, 80, 0.4); color: #4CAF50; }

.story-chapter-head {
  padding: 12px 14px 10px;
  flex-shrink: 0;
}

.story-chapter-num {
  font-size: 11px;
  color: #4CAF50;
  font-weight: 600;
  letter-spacing: 0.4px;
}

.story-title {
  font-size: 14px;
  font-weight: 600;
  color: #e0e6f0;
  line-height: 1.35;
  margin-top: 4px;
}

.story-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 12px 10px;
  min-height: 0;
}

/* --------------------------------------------------- Message cle */

.story-keymessage {
  display: block;
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.13), rgba(33, 150, 243, 0.1));
  border: 1px solid rgba(76, 175, 80, 0.28);
  border-left: 3px solid #4CAF50;
  border-radius: 9px;
  padding: 10px 12px;
  font-size: 12px;
  line-height: 1.55;
  color: #d6e4d8;
  margin-bottom: 10px;
}

/* ------------------------------------------------------- Indicateurs */

.story-indicators {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  padding-top: 4px;
}

.story-metric {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;
  padding: 8px 9px;
  position: relative;
  cursor: help;
}

.story-metric-value {
  font-size: 17px;
  font-weight: 700;
  color: #4CAF50;
  line-height: 1.1;
}

.story-metric-unit {
  font-size: 10px;
  color: #667788;
  font-weight: 500;
  margin-left: 3px;
}

.story-metric-label {
  font-size: 10px;
  color: #8899aa;
  margin-top: 3px;
  line-height: 1.25;
}

.story-metric-level {
  position: absolute;
  top: 6px;
  right: 6px;
  font-size: 8px;
  padding: 1px 4px;
  border-radius: 3px;
  letter-spacing: 0.2px;
}

.story-metric.pulse { animation: metricPulse 0.9s ease; }

@keyframes metricPulse {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.5); }
  50% { transform: scale(1.04); box-shadow: 0 0 0 5px rgba(76, 175, 80, 0); }
  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(76, 175, 80, 0); }
}

/* ---------------------------------------------------------- Timeline */

.story-timeline {
  margin-top: 12px;
  padding: 9px 10px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;
}

.story-timeline label {
  display: block;
  font-size: 10px;
  color: #8899aa;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  margin-bottom: 5px;
}

.story-timeline input[type="range"] {
  width: calc(100% - 34px);
  accent-color: #4CAF50;
  vertical-align: middle;
}

.story-timeline span {
  font-size: 12px;
  color: #4CAF50;
  font-weight: 600;
  margin-left: 4px;
  vertical-align: middle;
}

/* ---------------------------------------------------------- Contrôles */

.story-controls {
  display: flex;
  gap: 5px;
  padding: 9px 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  flex-shrink: 0;
  flex-wrap: wrap;
}

.story-btn {
  flex: 1;
  min-width: 32px;
  padding: 7px 6px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #e0e6f0;
  border-radius: 6px;
  font-size: 12px;
  cursor: pointer;
  transition: all 0.18s;
}

.story-btn:hover { background: rgba(255, 255, 255, 0.12); }
.story-btn-play { background: rgba(76, 175, 80, 0.18); border-color: rgba(76, 175, 80, 0.4); color: #4CAF50; }
.story-btn-play:hover { background: rgba(76, 175, 80, 0.28); }

.story-progress {
  display: flex;
  gap: 5px;
  padding: 0 12px 8px;
  flex-shrink: 0;
}

.story-progress-dot {
  flex: 1;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.15);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all 0.25s;
}

.story-progress-dot:hover { background: rgba(255, 255, 255, 0.35); }
.story-progress-dot.done { background: rgba(76, 175, 80, 0.55); }
.story-progress-dot.active { background: #4CAF50; box-shadow: 0 0 6px #4CAF50; }

.story-audio {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px 10px;
  font-size: 11px;
  color: #8899aa;
  flex-shrink: 0;
}

.story-audio input[type="range"] { width: 70px; accent-color: #4CAF50; }
.story-audio label { display: flex; align-items: center; gap: 4px; cursor: pointer; }

.story-freelook {
  align-items: center;
  gap: 8px;
  margin: 0 12px 10px;
  padding: 7px 10px;
  background: rgba(255, 193, 7, 0.12);
  border: 1px solid rgba(255, 193, 7, 0.35);
  border-radius: 7px;
  font-size: 11px;
  color: #FFD600;
  flex-shrink: 0;
}

.story-mini-btn {
  margin-left: auto;
  background: rgba(255, 193, 7, 0.2);
  border: 1px solid rgba(255, 193, 7, 0.4);
  color: #FFD600;
  border-radius: 5px;
  font-size: 10px;
  padding: 3px 7px;
  cursor: pointer;
}

.story-mini-btn:hover { background: rgba(255, 193, 7, 0.32); }

/* ------------------------------------------------------------- Caption */

.story-caption {
  position: absolute;
  bottom: 26px;
  left: 50%;
  transform: translateX(-50%);
  max-width: 560px;
  background: rgba(13, 18, 32, 0.86);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-left: 3px solid #4CAF50;
  border-radius: 10px;
  padding: 12px 18px;
  font-size: 14px;
  line-height: 1.55;
  color: #e0e6f0;
  text-align: left;
  z-index: 21;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
}

.story-caption-icon { margin-right: 8px; opacity: 0.85; }
.story-caption.pulse { animation: captionIn 0.45s ease; }

@keyframes captionIn {
  from { opacity: 0.25; transform: translateX(-50%) translateY(6px); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* ---------------------------------------------------------- Mini-carte */

.story-minimap {
  position: absolute;
  right: 16px;
  bottom: 16px;
  width: 190px;
  height: 190px;
  background: rgba(13, 18, 32, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  overflow: hidden;
  z-index: 21;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
}

.story-minimap-label {
  position: absolute;
  top: 0; left: 0; right: 0;
  padding: 4px 8px;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #8899aa;
  background: rgba(13, 18, 32, 0.9);
  z-index: 2;
}

#story-minimap-canvas { position: absolute; inset: 20px 0 0 0; }

/* --------------------------------------------------------- Popup story */

.maplibregl-popup.story-popup .maplibregl-popup-content {
  background: rgba(13, 18, 32, 0.96);
  border: 1px solid rgba(76, 175, 80, 0.35);
  border-radius: 10px;
  color: #e0e6f0;
  padding: 12px 14px;
  max-width: 340px;
  box-shadow: 0 10px 36px rgba(0, 0, 0, 0.5);
}

.maplibregl-popup.story-popup .maplibregl-popup-tip { border-top-color: rgba(76, 175, 80, 0.5); }

.popup-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.12);
  margin: 8px 0 6px;
}

/* ------------------------------------------------------- Bouton d'entree */

.story-toggle {
  /* Empilement des deux boutons flottants au-dessus du bandeau de crédit :
       bouton tableau de bord : 10 px de marge, puis 48 px de haut  → haut à +58
       bouton Story           : +58, plus 12 px de respiration       → +70
     Sans le calcul explicite, les deux boutons se chevauchaient de 4 px — ce
     que le banc d'essai a relevé. */
  bottom: calc(var(--credit-bar-h) + 70px);
  right: 20px;
  background: rgba(76, 175, 80, 0.2);
  border-color: rgba(76, 175, 80, 0.4);
  color: #4CAF50;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.4px;
}

/* ------------------------------------------------------- Onglets story */

.story-tabs {
  display: flex;
  gap: 4px;
  padding: 0 12px 8px;
  flex-shrink: 0;
}

.story-tab {
  flex: 1;
  padding: 6px 4px;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 6px;
  color: #8899aa;
  font-size: 10.5px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.18s;
}

.story-tab:hover { color: #e0e6f0; background: rgba(255, 255, 255, 0.06); }
.story-tab.active {
  color: #4CAF50;
  border-color: rgba(76, 175, 80, 0.45);
  background: rgba(76, 175, 80, 0.12);
}

.story-panel { min-height: 0; }

/* -------------------------------------------------- Detail indicateur */

.story-metric-detail {
  display: none;
  margin-top: 9px;
  padding: 9px 10px;
  background: rgba(33, 150, 243, 0.09);
  border: 1px solid rgba(33, 150, 243, 0.28);
  border-radius: 8px;
  font-size: 11px;
  color: #c8d6e5;
}

.story-metric-detail.visible { display: block; animation: captionIn 0.3s ease; }

.smd-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  color: #e0e6f0;
  margin-bottom: 6px;
}

.smd-close {
  margin-left: auto;
  background: transparent;
  border: none;
  color: #8899aa;
  font-size: 15px;
  line-height: 1;
  cursor: pointer;
}

.smd-value {
  font-size: 20px;
  font-weight: 700;
  color: #4CAF50;
  margin-bottom: 6px;
}

.smd-value small { font-size: 10px; color: #667788; font-weight: 500; }

.smd-row {
  display: flex;
  gap: 8px;
  justify-content: space-between;
  padding: 3px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.smd-row span { color: #8899aa; }
.smd-row code { font-size: 10px; color: #FFD600; text-align: right; }
.smd-note { margin: 6px 0 0; color: #667788; font-size: 9.5px; }

.story-interactive-hint {
  display: none;
  align-items: center;
  margin: 0 12px 8px;
  padding: 7px 10px;
  background: rgba(76, 175, 80, 0.12);
  border: 1px solid rgba(76, 175, 80, 0.35);
  border-radius: 7px;
  color: #8BD48F;
  font-size: 10.5px;
  line-height: 1.4;
  flex-shrink: 0;
}

/* ------------------------------------------------------ Chaîne de valeur */

.chain-mode {
  display: flex;
  gap: 4px;
  margin-bottom: 6px;
}

.chain-mode-btn {
  flex: 1;
  padding: 5px 3px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 5px;
  color: #8899aa;
  font-size: 9.5px;
  font-weight: 600;
  cursor: pointer;
}

.chain-mode-btn:hover { color: #e0e6f0; }
.chain-mode-btn.active {
  color: #4CAF50;
  border-color: rgba(76, 175, 80, 0.4);
  background: rgba(76, 175, 80, 0.12);
}

.chain-hint {
  margin: 0 0 8px;
  font-size: 9.5px;
  color: #667788;
  line-height: 1.35;
}

.chain-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}

.chain-grid.two { grid-template-columns: 1fr 1fr; gap: 7px; }

/* Les libellés longs ne doivent pas élargir la grille au-delà du rail. */
.chain-grid > * { min-width: 0; }
.chain-node-label,
.chain-lane-head,
.chain-shared-item { overflow-wrap: anywhere; }

.chain-lane {
  padding: 7px;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-top: 2px solid var(--lane);
  border-radius: 8px;
}

.chain-lane-head {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  font-weight: 700;
  color: var(--lane);
  margin-bottom: 6px;
  letter-spacing: 0.2px;
}

.chain-lane-dot {
  width: 6px; height: 6px; border-radius: 50%; background: var(--lane);
}

.chain-node {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  padding: 6px 7px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 7px;
  color: #e0e6f0;
  text-align: left;
  cursor: pointer;
  transition: all 0.18s;
}

.chain-node:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: var(--lane);
  transform: translateX(2px);
}

.chain-node.active {
  background: color-mix(in srgb, var(--lane) 18%, transparent);
  border-color: var(--lane);
  box-shadow: 0 0 0 1px var(--lane);
}

.chain-node-icon { font-size: 15px; line-height: 1; flex-shrink: 0; }
.chain-node-main { flex: 1; min-width: 0; }
.chain-node-label {
  display: block;
  font-size: 10.5px;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chain-node-value {
  display: block;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--lane);
  line-height: 1.2;
}

.chain-node-unit { font-size: 8.5px; color: #667788; margin-left: 2px; }

.chain-node-level {
  font-size: 7.5px;
  padding: 1px 4px;
  border-radius: 3px;
  flex-shrink: 0;
}

.chain-link {
  display: flex;
  align-items: center;
  gap: 4px;
  width: 100%;
  padding: 3px 2px;
  background: transparent;
  border: none;
  color: #667788;
  font-size: 8.5px;
  cursor: pointer;
  line-height: 1.2;
}

.chain-link:hover { color: #FFD600; }
.chain-link.active { color: #FFD600; }
.chain-link-text { text-align: left; }
.chain-link-dot {
  width: 1px; height: 12px; background: currentColor; opacity: 0.55; margin-left: 6px; flex-shrink: 0;
}

.chain-link-empty { cursor: default; }

.chain-grid.two .chain-node { padding: 5px; gap: 4px; }
.chain-grid.two .chain-node-icon { font-size: 12px; }
.chain-grid.two .chain-node-label { font-size: 9px; line-height: 1.25; white-space: normal; overflow: visible; overflow-wrap: anywhere; }
.chain-grid.two .chain-node-value { font-size: 11px; }
.chain-grid.two .chain-link { font-size: 8px; }

.chain-shared {
  margin-top: 10px;
  padding: 8px;
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.08), rgba(255, 179, 0, 0.08));
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 8px;
}

.chain-shared-head {
  font-size: 9.5px;
  font-weight: 700;
  color: #e0e6f0;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.chain-shared-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
}

.chain-shared-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1px;
  padding: 5px 6px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
  color: #e0e6f0;
  cursor: pointer;
  text-align: left;
}

.chain-shared-item:hover { border-color: #4CAF50; }
.chain-shared-item.active { border-color: #4CAF50; background: rgba(76, 175, 80, 0.14); }
.chain-shared-icon { font-size: 12px; }
.chain-shared-value { font-size: 12px; font-weight: 700; color: #4CAF50; }
.chain-shared-unit { font-size: 8px; color: #667788; margin-left: 2px; }
.chain-shared-label { font-size: 8.5px; color: #8899aa; line-height: 1.2; }
.chain-shared-note { margin: 7px 0 0; font-size: 9.5px; color: #8899aa; line-height: 1.4; }

.chain-detail {
  margin-top: 10px;
  padding: 9px 10px;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left: 3px solid #4CAF50;
  border-radius: 8px;
  font-size: 10.5px;
  color: #c8d6e5;
  line-height: 1.45;
}

.chain-detail:empty { display: none; }

.chain-detail-head {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 6px;
  flex-wrap: wrap;
}

.chain-detail-icon { font-size: 15px; }
.chain-detail-title { font-size: 12px; font-weight: 700; color: #e0e6f0; }
.chain-detail-value { margin-left: auto; font-size: 14px; font-weight: 700; color: #4CAF50; }
.chain-detail-value small { font-size: 8.5px; color: #667788; }
.chain-detail-role { margin: 0 0 6px; }
.chain-detail-enables { margin: 0 0 6px; }
.chain-detail-enables strong { color: #8BD48F; }
.chain-detail-extra { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
.chain-detail-chip {
  padding: 2px 5px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 4px;
  font-size: 9px;
  color: #8899aa;
}

.chain-detail-proof {
  font-size: 9px;
  color: #8899aa;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  padding-top: 6px;
}

.chain-flux-btn {
  width: 100%;
  margin-top: 7px;
  padding: 6px;
  background: rgba(255, 214, 0, 0.12);
  border: 1px solid rgba(255, 214, 0, 0.35);
  border-radius: 5px;
  color: #FFD600;
  font-size: 9.5px;
  font-weight: 600;
  cursor: pointer;
}

.chain-flux-btn:hover { background: rgba(255, 214, 0, 0.2); }
.chain-flux-note { margin-top: 5px; font-size: 8.5px; color: #667788; line-height: 1.35; }

/* --------------------------------------------------------- Diagnostic */

.diag-intro, .diag-method, .diag-read {
  font-size: 9.5px;
  color: #8899aa;
  line-height: 1.45;
  margin: 0 0 8px;
}

.diag-method { margin-top: 10px; color: #667788; font-size: 8.5px; }

.diag-thresholds { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }

.diag-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 8px;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
  color: #8899aa;
  font-size: 9.5px;
  cursor: pointer;
  text-align: left;
}

.diag-toggle.active { color: #e0e6f0; border-color: rgba(255, 255, 255, 0.2); }
.diag-toggle:not(.active) { opacity: 0.45; }
.diag-toggle-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

.diag-main { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.diag-big { font-size: 34px; font-weight: 800; color: #4CAF50; line-height: 1; letter-spacing: -1px; }
.diag-big small { font-size: 13px; color: #667788; margin-left: 2px; }
.diag-big-label { font-size: 9.5px; color: #8899aa; line-height: 1.35; }

.diag-bar {
  display: flex;
  height: 8px;
  border-radius: 4px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
  margin-bottom: 8px;
}

.diag-seg { height: 100%; transition: width 0.45s ease; }
.diag-counts { margin-bottom: 8px; }

.diag-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 9.5px;
  color: #c8d6e5;
}

.diag-row.off { opacity: 0.4; }
.diag-row-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.diag-row-label { flex: 1; }
.diag-row-value { font-weight: 700; color: #4CAF50; }
.diag-row-count { width: 46px; text-align: right; color: #667788; font-size: 8.5px; }

.diag-median { margin-top: 6px; font-size: 8.5px; color: #667788; line-height: 1.4; }

.diag-actions { display: flex; gap: 5px; }

.diag-btn {
  flex: 1;
  padding: 7px 5px;
  background: rgba(76, 175, 80, 0.14);
  border: 1px solid rgba(76, 175, 80, 0.34);
  border-radius: 6px;
  color: #4CAF50;
  font-size: 9.5px;
  font-weight: 600;
  cursor: pointer;
}

.diag-btn:hover:not(:disabled) { background: rgba(76, 175, 80, 0.24); }
.diag-btn:disabled { opacity: 0.4; cursor: default; }

.diag-progress { font-size: 9px; color: #8899aa; }
.diag-progress p { margin: 5px 0; }
.diag-progress-bar { height: 5px; background: rgba(255, 255, 255, 0.1); border-radius: 3px; overflow: hidden; }
.diag-progress-bar > div { height: 100%; background: #4CAF50; transition: width 0.2s; }
.diag-error { color: #EF5350; }

.diag-subhead {
  font-size: 9px;
  font-weight: 700;
  color: #e0e6f0;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin: 10px 0 5px;
}

.diag-filiere {
  display: grid;
  grid-template-columns: 62px 1fr 38px;
  align-items: center;
  gap: 5px;
  font-size: 8.5px;
  color: #8899aa;
  margin-bottom: 3px;
}

.diag-filiere-bar { height: 5px; background: rgba(255, 255, 255, 0.08); border-radius: 3px; overflow: hidden; }
.diag-filiere-bar > span { display: block; height: 100%; background: #4CAF50; }
.diag-filiere-val { text-align: right; color: #8BD48F; font-weight: 600; }

.diag-api { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 5px; }
.diag-api-item {
  display: flex;
  flex-direction: column;
  padding: 6px;
  background: rgba(255, 179, 0, 0.08);
  border: 1px solid rgba(255, 179, 0, 0.22);
  border-radius: 6px;
}

.diag-api-item strong { font-size: 13px; color: #FFB300; }
.diag-api-item span { font-size: 8px; color: #8899aa; line-height: 1.25; margin-top: 2px; }

.diag-weak {
  margin: 0 0 8px;
  padding: 6px 8px;
  background: rgba(239, 83, 80, 0.1);
  border: 1px solid rgba(239, 83, 80, 0.3);
  border-radius: 5px;
  color: #FF8A80;
  font-size: 9px;
  line-height: 1.4;
}

/* ------------------------------------------------- Mouvement reduit */

@media (prefers-reduced-motion: reduce) {
  .story-rail { transition: none !important; }
  .story-caption { transition: none !important; animation: none !important; }
  .story-metric.pulse { animation: none !important; }
}

/* ------------------------------------------------------------ Responsive */

@media (max-width: 900px) {
  .story-rail { width: 260px; }
  .story-caption { max-width: 92%; font-size: 12.5px; bottom: 18px; }
  .story-minimap { width: 120px; height: 120px; }
  .story-indicators { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
  .story-rail { width: calc(100% - 24px); bottom: auto; max-height: 52vh; }
  .story-minimap { display: none; }
}
